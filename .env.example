# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Supabase PostgreSQL (already working)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Supabase Storage (NEW - same project as database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Business Info
BUSINESS_NAME=Sanctuary Massage
BUSINESS_LOCATION=Stadeview Apartments, Kisauni Rd, Nairobi
BUSINESS_PHONE=+254700000000
BUSINESS_EMAIL=info@sanctuarymassage.com
TILL_NUMBER=123456
WHATSAPP_NUMBER=254700000000

# Admin
ADMIN_EMAIL=admin@sanctuarymassage.com
ADMIN_PASSWORD=your-admin-password

# Database Pool
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVE_IDLE=30
DB_KEEPALIVE_INTERVAL=10
DB_KEEPALIVE_COUNT=5

# Upload
MAX_CONTENT_LENGTH=52428800
