{% extends "base.html" %}

{% block title %}Site Settings - Admin{% endblock %}

{% block content %}
<div class="min-h-screen bg-dark-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-dark-900">Site Settings</h1>
                <p class="text-gray-600">Configure your business information and preferences</p>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6 space-y-8">
            <form id="settingsForm" class="space-y-6" enctype="multipart/form-data">
                <!-- Business Information -->
                <div>
                    <h3 class="text-lg font-semibold text-dark-900 border-b border-gray-200 pb-3 mb-4">
                        <i class="fas fa-building text-gold-500 mr-2"></i>Business Information
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Business Name *</label>
                            <input type="text" id="businessName" name="business_name" 
                                   value="{{ settings.business_name|default('Sanctuary Massage') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Till Number *</label>
                            <input type="text" id="tillNumber" name="till_number" 
                                   value="{{ settings.till_number|default('123456') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Location *</label>
                        <input type="text" id="businessLocation" name="business_location" 
                               value="{{ settings.business_location|default('Stadeview Apartments, Kisauni Rd, Nairobi') }}"
                               class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" id="businessPhone" name="business_phone" 
                                   value="{{ settings.business_phone|default('+254700000000') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="businessEmail" name="business_email" 
                                   value="{{ settings.business_email|default('info@sanctuarymassage.com') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp Number</label>
                        <input type="tel" id="whatsappNumber" name="whatsapp_number" 
                               value="{{ settings.whatsapp_number|default('254700000000') }}"
                               class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                    </div>
                </div>

                <!-- Hero Video -->
                <div>
                    <h3 class="text-lg font-semibold text-dark-900 border-b border-gray-200 pb-3 mb-4">
                        <i class="fas fa-video text-gold-500 mr-2"></i>Hero Video
                    </h3>
                    
                    <div class="drop-zone p-8 text-center rounded-xl cursor-pointer" 
                         onclick="document.getElementById('heroVideoInput').click()"
                         ondrop="handleVideoDrop(event)" ondragover="handleVideoDragOver(event)">
                        <i class="fas fa-cloud-upload-alt text-4xl text-gold-400 mb-3"></i>
                        <p class="text-gray-600">Drag & drop your hero video here, or click to browse</p>
                        <p class="text-sm text-gray-400 mt-1">MP4, MOV, WebM (Max 50MB)</p>
                        <input type="file" id="heroVideoInput" name="hero_video" accept="video/*" class="hidden">
                    </div>
                    
                    {% if settings.hero_video_url %}
                    <div class="mt-4 p-4 bg-gray-50 rounded-xl flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <i class="fas fa-check-circle text-emerald-500 text-xl"></i>
                            <span class="text-sm text-gray-600">Current video uploaded</span>
                        </div>
                        <button type="button" onclick="removeHeroVideo()" 
                                class="text-red-500 hover:text-red-700 text-sm font-medium">
                            Remove
                        </button>
                    </div>
                    {% endif %}
                </div>

                <!-- Gallery Images -->
                <div>
                    <h3 class="text-lg font-semibold text-dark-900 border-b border-gray-200 pb-3 mb-4">
                        <i class="fas fa-images text-gold-500 mr-2"></i>Gallery Images
                    </h3>
                    
                    <div class="drop-zone p-8 text-center rounded-xl cursor-pointer mb-4"
                         onclick="document.getElementById('galleryInput').click()"
                         ondrop="handleGalleryDrop(event)" ondragover="handleGalleryDragOver(event)">
                        <i class="fas fa-cloud-upload-alt text-4xl text-gold-400 mb-3"></i>
                        <p class="text-gray-600">Drag & drop multiple images, or click to browse</p>
                        <p class="text-sm text-gray-400 mt-1">PNG, JPG, JPEG, WebP (Max 5MB each)</p>
                        <input type="file" id="galleryInput" name="gallery_images" accept="image/*" multiple class="hidden">
                    </div>
                    
                    <div id="galleryGrid" class="upload-preview-grid">
                        {% for image in settings.gallery_images %}
                        <div class="upload-preview-item">
                            <img src="{{ image.url }}" alt="{{ image.title }}">
                            <button onclick="removeGalleryImage('{{ image.id }}')" class="remove-btn">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Operating Hours -->
                <div>
                    <h3 class="text-lg font-semibold text-dark-900 border-b border-gray-200 pb-3 mb-4">
                        <i class="fas fa-clock text-gold-500 mr-2"></i>Operating Hours
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Monday - Friday</label>
                            <input type="text" id="weekdayHours" name="weekday_hours" 
                                   value="{{ settings.weekday_hours|default('9:00 AM - 9:00 PM') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Saturday</label>
                            <input type="text" id="saturdayHours" name="saturday_hours" 
                                   value="{{ settings.saturday_hours|default('9:00 AM - 9:00 PM') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Sunday</label>
                            <input type="text" id="sundayHours" name="sunday_hours" 
                                   value="{{ settings.sunday_hours|default('10:00 AM - 6:00 PM') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                    </div>
                </div>

                <!-- Admin Login Settings -->
                <div>
                    <h3 class="text-lg font-semibold text-dark-900 border-b border-gray-200 pb-3 mb-4">
                        <i class="fas fa-user-shield text-gold-500 mr-2"></i>Admin Security
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Admin Email</label>
                            <input type="email" id="adminEmail" name="admin_email" 
                                   value="{{ settings.admin_email|default('admin@sanctuarymassage.com') }}"
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">New Password (leave blank to keep current)</label>
                            <input type="password" id="adminPassword" name="admin_password" 
                                   class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-gold-400 outline-none"
                                   placeholder="Enter new password">
                        </div>
                    </div>
                </div>

                <button type="submit" 
                        class="w-full bg-gradient-to-r from-gold-500 to-gold-600 text-dark-900 py-4 rounded-2xl font-bold text-lg hover:shadow-2xl hover:shadow-gold-500/30 transition-all duration-300">
                    <i class="fas fa-save mr-2"></i>Save Settings
                </button>
            </form>
        </div>
    </div>
</div>

<script>
// Video upload handling
function handleVideoDrop(e) {
    e.preventDefault();
    e.target.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('video/')) {
        uploadHeroVideo(file);
    }
}

function handleVideoDragOver(e) {
    e.preventDefault();
    e.target.classList.add('dragover');
}

// Gallery upload handling
function handleGalleryDrop(e) {
    e.preventDefault();
    e.target.classList.remove('dragover');
    const files = e.dataTransfer.files;
    for (let file of files) {
        if (file.type.startsWith('image/')) {
            uploadGalleryImage(file);
        }
    }
}

function handleGalleryDragOver(e) {
    e.preventDefault();
    e.target.classList.add('dragover');
}

// Upload hero video
function uploadHeroVideo(file) {
    const formData = new FormData();
    formData.append('hero_video', file);
    
    fetch('/admin/api/settings/hero-video', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(result => {
        if (result.success) {
            location.reload();
        } else {
            alert('Error: ' + result.error);
        }
    });
}

// Upload gallery image
function uploadGalleryImage(file) {
    const formData = new FormData();
    formData.append('gallery_image', file);
    
    fetch('/admin/api/settings/gallery', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(result => {
        if (result.success) {
            location.reload();
        } else {
            alert('Error: ' + result.error);
        }
    });
}

// Remove gallery image
function removeGalleryImage(imageId) {
    if (confirm('Remove this image from gallery?')) {
        fetch(`/admin/api/settings/gallery/${imageId}`, {
            method: 'DELETE'
        })
        .then(res => res.json())
        .then(result => {
            if (result.success) {
                location.reload();
            } else {
                alert('Error: ' + result.error);
            }
        });
    }
}

// Remove hero video
function removeHeroVideo() {
    if (confirm('Remove hero video?')) {
        fetch('/admin/api/settings/hero-video', {
            method: 'DELETE'
        })
        .then(res => res.json())
        .then(result => {
            if (result.success) {
                location.reload();
            } else {
                alert('Error: ' + result.error);
            }
        });
    }
}

// Form submission
document.getElementById('settingsForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    
    try {
        const response = await fetch('/admin/api/settings', {
            method: 'POST',
            body: formData
        });
        const result = await response.json();
        if (result.success) {
            alert('Settings saved successfully!');
            location.reload();
        } else {
            alert('Error: ' + result.error);
        }
    } catch (error) {
        alert('An error occurred. Please try again.');
    }
});

// File input triggers
document.getElementById('heroVideoInput').addEventListener('change', function(e) {
    if (this.files[0]) {
        uploadHeroVideo(this.files[0]);
    }
});

document.getElementById('galleryInput').addEventListener('change', function(e) {
    for (let file of this.files) {
        uploadGalleryImage(file);
    }
});
</script>
{% endblock %}